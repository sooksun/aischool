{
  "name": "seip",
  "private": true,
  "version": "0.0.0",
  "description": "School Evidence Intelligence Platform. Root gate-runner + backend workspace (Sprint 1). Adding scripts arms the matching CI gate (see docs/qa/QUALITY-GATES.md).",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gate:ownership": "node scripts/orchestration/validate-ownership.mjs",
    "gate:contracts": "node scripts/security/validate-contracts.mjs",
    "gate:secret-scan": "node scripts/security/run-gitleaks.mjs",
    "gate:dep-audit": "npm audit --audit-level=high",
    "codegen:contracts": "node scripts/codegen/generate-contract-constants.mjs",
    "codegen:api-types": "npx --yes openapi-typescript@7 docs/contracts/openapi.yaml -o apps/web/src/api/schema.generated.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/db/migrate.mjs deploy",
    "db:migrate:dev": "node --env-file-if-exists=.env scripts/db/migrate.mjs dev",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.mjs",
    "db:reset": "node --env-file-if-exists=.env scripts/db/migrate.mjs reset --force",
    "provision:school": "npm run build:libs && node --env-file-if-exists=.env scripts/ops/provision-school.mjs",
    "bootstrap:admin": "npm run build:libs && node --env-file-if-exists=.env scripts/ops/bootstrap-admin.mjs",
    "rescan:files": "npm run build:libs && node --env-file-if-exists=.env scripts/ops/rescan-files.mjs",
    "backup": "node --env-file-if-exists=.env scripts/ops/backup.mjs",
    "restore": "node --env-file-if-exists=.env scripts/ops/restore.mjs",
    "test:backend": "node --test \"tests/backend/*.test.mjs\"",
    "test:integration": "node --test \"tests/backend/*.test.mjs\"",
    "test:security": "npm run build:libs && npm run build --workspace apps/api && node --env-file-if-exists=.env --test \"tests/security/*.test.mjs\"",
    "build:libs": "npm run build --workspace=packages/backend-shared && npm run build --workspace=packages/auth && npm run build --workspace=packages/database",
    "build": "npm run build:libs && npm run build --workspaces --if-present",
    "typecheck": "npm run build:libs && npm run typecheck --workspaces --if-present",
    "lint": "npm run build:libs && npm run lint --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "test:unit": "npm run build:libs && npm run test:unit --workspaces --if-present",
    "test:e2e": "playwright test",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:worker": "npm run build:libs && npm run build --workspace apps/worker && npm run start --workspace apps/worker",
    "db:bootstrap": "psql -v ON_ERROR_STOP=1 -f scripts/db/bootstrap-roles.sql"
  },
  "dependencies": {
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@playwright/test": "^1.51.0",
    "js-yaml": "^4.3.0",
    "pg": "^8.23.1",
    "prisma": "7.10.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.5"
  }
}
