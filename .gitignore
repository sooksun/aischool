# Dependencies / build output
node_modules/
dist/
build/
.next/
coverage/
*.tsbuildinfo

# Environment & secrets — never commit
.env
.env.*
!.env.example
!.env.staging.example

# Local credential notes. autokey.md holds a live n8n API key (all scopes) and
# says so in its own footer; it sat untracked-but-unignored, one `git add -A`
# away from the history. gate:secret-scan only sees committed blobs, so it would
# not have caught it either. Pattern is broad on purpose.
autokey.md
*.key
*.pem
**/secrets.*

# Uploaded evidence (personal data — lives in object storage, never in git)
uploads/
storage/

# Agent worktrees (local working copies)
.worktrees/

# Legacy docs archive (decision: keep on disk, untracked — see SEIP-OPS-001 handoff)
aischool-docs.zip

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Playwright e2e (SEIP-QA-004)
tests/e2e/.auth/
test-results/
playwright-report/
blob-report/

# Artifacts dropped in the repo root by e2e runs — a downloaded PA report and an
# upload fixture. Generated output, and the report kind carries evidence data.
/PA2_s-*.pdf
/e2e-*.pdf


# Backup artefacts (ops-runbook §5). Dumps contain every evaluation score and
# every teacher-uploaded file: PDPA data. They must never reach git.
backups/
