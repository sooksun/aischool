// SEIP core schema — SEIP-DB-001
// Implements docs/architecture/data-model/entity-dictionary.md (design reviewed in
// docs/reviews/SEIP-DB-000-claude-review.md). Rules it must uphold come from
// docs/architecture/evaluation-framework.md (ADR-0003):
//   - taxonomy is versioned DATA (framework -> domain -> indicator -> level text)
//   - rounds are configurable 1..n per cycle (never hard-coded to 2)
//   - scores are PER EVALUATOR (3-member committee); pass = every evaluator >= 70%
//   - ภาระงาน (workload) is a boolean gate, separate from scored indicators
//   - score weights (60/40, 20/10/10) are data, not constants
// Constraints Prisma cannot express (partial unique indexes, CHECKs, audit
// immutability) live in prisma/migrations/*/constraints.sql — see DB-001 close-out.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and in the
// driver adapter (packages/database/src/client.ts), not here.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────── enums ───────────────────────────

enum SchoolStatus {
  active
  inactive
}

enum UserStatus {
  active
  disabled
  invited
}

enum Role {
  teacher
  director
  deputy
  evaluator
  school_admin
  area_admin
  dpo
}

enum MembershipScope {
  school
  area
}

enum RoleFamily {
  teacher
  administrator
}

enum FrameworkStatus {
  draft
  active
  superseded
}

enum DomainPart {
  standards
  challenge
}

enum IndicatorKind {
  standard
  challenge
  workload_gate
}

enum EvaluationKind {
  pa
  dpa
}

enum CycleStatus {
  planned
  open
  closed
}

enum RoundStatus {
  planned
  open
  scoring
  closed
}

enum AgreementStatus {
  draft
  submitted
  acknowledged
}

enum EvidenceStatus {
  draft
  active
  archived
  rejected
}

/// CCR-012: `unscanned` = processed, but NO scanner ran, so the platform makes no
/// claim about the contents. It is served like `clean` — the distinction is
/// disclosure, not restriction. `blocked` is quarantine: a scanner rejected the
/// file, or the stored object did not match the declared byte_size. Replaces a
/// stub that reported `clean` for every filename it did not recognise.
enum ScanStatus {
  pending
  clean
  sanitised
  unscanned
  blocked
}

/// ADR-0013: S3 Bangkok in production, SeaweedFS in dev/CI — configuration, not a
/// migration — adding a value here would mean a genuinely different storage protocol.
enum StorageProvider {
  s3_compatible
}

/// ai_suggested is reserved for the Sprint 2 mapping engine (OPEN-3). It exists now
/// so that adding AI later is not a schema change — but a suggestion still requires
/// human confirmation to count.
enum MappingSource {
  ai_accepted
  manual
}

enum EvidenceKind {
  file
  link
  note
}

enum PerformedDateSource {
  teacher
  exif
  ai_suggested_confirmed
}

enum ContainsLearners {
  unknown
  yes
  no
}

/// Only `original` is uploaded by clients; every other role is a server rendition.
enum FileRole {
  original
  review_720p
  audio_16k
  audio_proxy
  keyframe
  poster
  ocr_pdf
  blurred
  redacted
  dpa_ready
}

enum MediaState {
  uploading
  verifying
  processing
  ready
  failed
}

enum UploadProtocol {
  single_put
  s3_multipart
}

enum UploadStatus {
  open
  completing
  completed
  aborted
  expired
}

/// Two-tier confirmation (ADR-0015, CCR-017): the owner confirms; the director
/// or an assigned committee member validates or returns. AI output is not a
/// mapping until the owner accepts it.
enum MappingStatus {
  owner_confirmed
  validated
  returned
  revoked
}

enum ValidatorRole {
  director
  committee
}

enum AssignmentStatus {
  pending
  in_progress
  completed
  void
}

enum CommitteeRole {
  chair
  member
}

enum ReportStatus {
  draft
  pending_approval
  approved
  issued
  superseded
}

enum ApprovalDecision {
  pending
  approved
  rejected
  returned
}

// ─────────────────────── tenancy & identity ───────────────────────

model Area {
  id      String   @id @default(uuid()) @db.Uuid
  code    String   @unique
  name    String
  schools School[]
  memberships SchoolMembership[]
  controlledEvidence Evidence[]

  @@map("area")
}

/// Tenant boundary. Nearly every operational row carries schoolId; the API derives
/// it from the caller's membership and never accepts it as a parameter (ARCH-001).
model School {
  id     String       @id @default(uuid()) @db.Uuid
  code   String       @unique
  name   String
  areaId String?      @map("area_id") @db.Uuid
  status SchoolStatus @default(active)
  area   Area?        @relation(fields: [areaId], references: [id], onDelete: Restrict)

  memberships SchoolMembership[]
  personnel   PersonnelProfile[]
  cycles      EvaluationCycle[]
  agreements  PerformanceAgreement[]
  evidence    Evidence[]
  mappings    EvidenceIndicatorMapping[]
  assignments EvaluationAssignment[]
  reports     Report[]
  approvals   Approval[]
  passwordResets PasswordReset[]

  @@index([areaId])
  @@map("school")
}

/// Login identity. Separate from PersonnelProfile: an account is who you authenticate
/// as; a profile is your employment record at a school.
/// The human (ADR-0015). Owns the evidence portfolio across schools; a person
/// may exist before they have an account (HR import, P1). Citizen-id columns
/// (cid_hmac / cid_enc) arrive with the ThaID work in P1.
model Person {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String   @map("display_name")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  account   UserAccount?
  personnel PersonnelProfile[]
  evidence  Evidence[]

  @@map("person")
}

model UserAccount {
  id           String     @id @default(uuid()) @db.Uuid
  personId     String?    @unique @map("person_id") @db.Uuid
  email        String     @unique                  // stored lowercase — enforced in app + CHECK
  displayName  String     @map("display_name")
  /// SEIP-API-001 addition: DB-000/DB-001 modeled the evaluation domain, not
  /// credential storage — no field existed to log in with. Argon2id PHC string
  /// only (SEC-AUTH-1); nullable because an `invited` account has no password
  /// until it's accepted, and a future SSO account may never have one.
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(invited)
  createdAt    DateTime   @default(now()) @map("created_at")
  /// CCR-014 onboarding. SHA-256 of a single-use invite secret — never the
  /// secret itself, same handling as RefreshToken.tokenHash. Both columns are
  /// cleared in the transaction that sets passwordHash, so a non-null
  /// inviteTokenHash means "invited and not yet accepted". No separate table:
  /// an invite is 1:1 with the account it creates.
  inviteTokenHash String?   @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at")
  /// ADR-0014: when a Keycloak user carrying this account's id (`seip_uid`) was
  /// confirmed to exist. Null = not yet provisioned; the API provisions on the
  /// next accept-invite or password login, the two moments it holds the password.
  kcLinkedAt      DateTime? @map("kc_linked_at")

  person            Person?                    @relation(fields: [personId], references: [id], onDelete: Restrict)
  memberships       SchoolMembership[]
  personnelProfiles PersonnelProfile[]
  uploadedEvidence  Evidence[]                 @relation("EvidenceUploader")
  ownerConfirmed    EvidenceIndicatorMapping[] @relation("MappingOwnerConfirmer")
  validated         EvidenceIndicatorMapping[] @relation("MappingValidator")
  uploadSessions    UploadSession[]
  idempotencyKeys   IdempotencyKey[]
  committeeSeats    CommitteeMember[]
  indicatorScores   IndicatorScore[]
  roundResults      RoundResult[]
  workloadDecls     WorkloadDeclaration[]
  approvals         Approval[]
  refreshTokens     RefreshToken[]
  deviceSessions DeviceSession[]
  passwordResets       PasswordReset[] @relation("PasswordResetFor")
  passwordResetsIssued PasswordReset[] @relation("PasswordResetBy")
  webSessions       WebSession[]

  @@map("user_account")
}

/// SEIP-API-001 addition: openapi.yaml's TokenPair promises a refresh_token, and
/// SECURITY-BASELINE SEC-AUTH-2 requires rotation with reuse detection + logout
/// revocation — neither is possible without server-side state, which DB-000/DB-001
/// did not model (auth wasn't in scope for the data-model design). Additive only:
/// no existing table changes. The raw token is a bearer secret — only its hash is
/// stored, so a DB read alone can never impersonate a session.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") // sha256 of the opaque token
  issuedAt     DateTime  @default(now()) @map("issued_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid // rotation chain: reuse of a revoked-and-replaced token is a theft signal

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_token")
}

/// A browser session behind the BFF (CCR-018, ADR-0014 §4). The cookie holds a
/// random value; only its SHA-256 is stored. The Keycloak refresh token is kept
/// encrypted (AES-256-GCM) and is used only to check, at most once a minute, that
/// the Keycloak session behind this one is still alive.
model WebSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  csrfHash         String    @map("csrf_hash")
  /// Level of authentication the sign-in proved (1 password, 2 second factor).
  acr              Int
  kcSessionId      String?   @map("kc_session_id")
  kcRefreshToken   String    @map("kc_refresh_token") // encrypted, base64(iv | tag | ciphertext)
  kcCheckDueAt     DateTime  @map("kc_check_due_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("web_session")
}

/// FR-099 / CCR-022: a one-time password reset issued by a school admin.
/// Only the token's hash is stored; 30 minutes at most (CHECK in the migration).
model PasswordReset {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  issuedByUserId String    @map("issued_by_user_id") @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")

  user     UserAccount @relation("PasswordResetFor", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy UserAccount @relation("PasswordResetBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  school   School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("password_reset")
}

/// FR-093: an app sign-in (a Keycloak offline session of seip-mobile). Revoking
/// it ends the Keycloak session and refuses its tokens at once.
model DeviceSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  kcSessionId String    @unique @map("kc_session_id")
  platform    String // 'android' | 'ios' (CHECK in the migration)
  appVersion  String?   @map("app_version")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")
  /// FR-100: where this app install receives its content-free push ping. Cleared on revoke.
  pushProvider String?  @map("push_provider")
  pushToken    String?  @map("push_token")

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("device_session")
}

/// Role of a user within a school, or across an area (area_admin, read-only per
/// permissions.yaml). This table is what the API resolves tenancy from.
model SchoolMembership {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  schoolId        String?         @map("school_id") @db.Uuid
  areaId          String?         @map("area_id") @db.Uuid
  role            Role
  membershipScope MembershipScope @map("membership_scope")
  effectiveFrom   DateTime        @map("effective_from") @db.Date
  effectiveTo     DateTime?       @map("effective_to") @db.Date
  status          String          @default("active")

  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School?     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  area   Area?       @relation(fields: [areaId], references: [id], onDelete: Restrict)

  // scope↔id agreement is the CHECK membership_scope_ids (constraints migration);
  // no-overlapping-active-membership is application-enforced (identity.ts inviteMember)
  @@index([userId, status])
  @@index([schoolId, role])
  @@map("school_membership")
}

// ─────────────────────────── personnel ───────────────────────────

/// วิทยฐานะ / expected-practice tier (Execute & Learn → Create an Impact).
/// Seeded reference data; `code` is stable and referenced by level descriptions.
model RankLevel {
  code       String     @id
  roleFamily RoleFamily @map("role_family")
  labelTh    String     @map("label_th")
  sortOrder  Int        @map("sort_order")

  personnel         PersonnelProfile[]
  levelDescriptions IndicatorLevelDescription[]

  @@map("rank_level")
}

/// The evaluatee / evidence owner as school staff (ครู or ผู้บริหาร).
model PersonnelProfile {
  id            String     @id @default(uuid()) @db.Uuid
  schoolId      String     @map("school_id") @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  personId      String     @map("person_id") @db.Uuid
  employeeCode  String?    @map("employee_code")
  fullName      String     @map("full_name")
  positionRole  RoleFamily @map("position_role") // selects ว9 vs ว10 framework
  rankLevelCode String     @map("rank_level_code")
  status        String     @default("active")
  /// FR-099a / CCR-023
  rankSince      DateTime? @map("rank_since") @db.Date
  confirmedAt    DateTime? @map("confirmed_at")
  correctionNote String?   @map("correction_note")

  school    School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)
  person    Person      @relation(fields: [personId], references: [id], onDelete: Restrict)
  rankLevel RankLevel   @relation(fields: [rankLevelCode], references: [code], onDelete: Restrict)

  agreements     PerformanceAgreement[]
  assignments    EvaluationAssignment[]
  reports        Report[]

  @@unique([schoolId, employeeCode], name: "personnel_school_employee_code")
  @@index([schoolId, status])
  @@index([personId])
  @@map("personnel_profile")
}

// ─────────── framework taxonomy (versioned data — Protected Artifact) ───────────

/// ว9/2564 (teacher) and ว10/2564 (administrator) are the first two rows, NOT the
/// schema. A future ก.ค.ศ. revision is a new row + new domain/indicator rows;
/// historical cycles keep pointing at the version they were evaluated under.
model FrameworkVersion {
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique              // e.g. v9-2564-teacher
  roleFamily    RoleFamily      @map("role_family")
  legalRef      String          @map("legal_ref")    // ศธ 0206.3/ว 9 ลว. 20 พ.ค. 2564
  revisionYear  Int             @map("revision_year")
  status        FrameworkStatus @default(draft)
  effectiveFrom DateTime        @map("effective_from") @db.Date
  effectiveTo   DateTime?       @map("effective_to") @db.Date

  domains    EvaluationDomain[]
  weights    ScoreWeight[]
  indicators Indicator[]
  cycles     EvaluationCycle[]
  mappings   EvidenceIndicatorMapping[]
  suggestions AiSuggestion[]

  @@index([roleFamily, status])
  @@map("framework_version")
}

/// ด้าน — 3 for teachers (ว9), 5 for administrators (ว10), plus the challenge part.
model EvaluationDomain {
  id                 String     @id @default(uuid()) @db.Uuid
  frameworkVersionId String     @map("framework_version_id") @db.Uuid
  code               String
  nameTh             String     @map("name_th")
  sortOrder          Int        @map("sort_order")
  part               DomainPart

  framework  FrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Cascade)
  indicators Indicator[]

  @@unique([frameworkVersionId, code])
  @@map("evaluation_domain")
}

/// ตัวชี้วัด. Teacher: T-1.1…T-3.3 (15) + T-C.* challenge items + workload gate.
/// Administrator: A-1.1…A-5.2 (15) + challenge items + workload gate.
/// frameworkVersionId is denormalized from the domain so (framework, code) can be unique.
model Indicator {
  id                 String        @id @default(uuid()) @db.Uuid
  domainId           String        @map("domain_id") @db.Uuid
  frameworkVersionId String        @map("framework_version_id") @db.Uuid
  code               String
  nameTh             String        @map("name_th")
  sortOrder          Int           @map("sort_order")
  isScored           Boolean       @default(true) @map("is_scored")
  indicatorKind      IndicatorKind @map("indicator_kind")
  maxPoints          Decimal?      @map("max_points") @db.Decimal(6, 2) // challenge items: 20/10/10

  domain    EvaluationDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  framework FrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Cascade)

  levelDescriptions IndicatorLevelDescription[]
  mappings          EvidenceIndicatorMapping[]
  suggestions       AiSuggestion[]
  scores            IndicatorScore[]
  challenges        AgreementChallenge[]

  @@unique([frameworkVersionId, code])
  @@index([domainId, sortOrder])
  @@map("indicator")
}

/// The same indicator is judged against a DIFFERENT expected level depending on the
/// person's วิทยฐานะ (framework §Scoring model). That text is data, never code.
model IndicatorLevelDescription {
  id                 String @id @default(uuid()) @db.Uuid
  indicatorId        String @map("indicator_id") @db.Uuid
  rankLevelCode      String @map("rank_level_code")
  rubricLevel        Int    @map("rubric_level") // 1..4 — CHECK in constraints.sql
  expectedPracticeTh String @map("expected_practice_th") @db.Text

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  rankLevel RankLevel @relation(fields: [rankLevelCode], references: [code], onDelete: Restrict)

  @@unique([indicatorId, rankLevelCode, rubricLevel])
  @@map("indicator_level_description")
}

/// 60/40 and 20/10/10 live here, per framework version — a future revision that
/// reweights the parts is a data change.
model ScoreWeight {
  id                 String  @id @default(uuid()) @db.Uuid
  frameworkVersionId String  @map("framework_version_id") @db.Uuid
  weightKey          String  @map("weight_key")   // part1_total | part2_total | challenge_method | ...
  weightValue        Decimal @map("weight_value") @db.Decimal(6, 2)
  notes              String? @db.Text

  framework FrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Cascade)

  @@unique([frameworkVersionId, weightKey])
  @@map("score_weight")
}

/// Framework-named evidence classes + the technical limits the API validates
/// against (openapi EvidenceCategory). ว9 sets the ≤10-minute inspiration video.
model EvidenceCategory {
  id                 String  @id @default(uuid()) @db.Uuid
  code               String  @unique
  labelTh            String  @map("label_th")
  allowedMimeTypes   String[] @map("allowed_mime_types")
  maxByteSize        BigInt? @map("max_byte_size")
  maxDurationSeconds Int?    @map("max_duration_seconds")
  requiredForDpa     Boolean @default(false) @map("required_for_dpa")

  evidence Evidence[]

  @@map("evidence_category")
}

// ──────────────────── cycles, rounds, agreements ────────────────────

/// Fiscal-year container (ปีงบประมาณ) for one school under one framework version.
/// framework_version_id PINS the taxonomy: changing the globally-active framework
/// must never rewrite a historical cycle's meaning.
model EvaluationCycle {
  id                 String         @id @default(uuid()) @db.Uuid
  schoolId           String         @map("school_id") @db.Uuid
  frameworkVersionId String         @map("framework_version_id") @db.Uuid
  fiscalYear         Int            @map("fiscal_year")
  evaluationKind     EvaluationKind @map("evaluation_kind")
  title              String         @db.VarChar(200)
  status             CycleStatus    @default(planned)
  startsOn           DateTime       @map("starts_on") @db.Date
  endsOn             DateTime       @map("ends_on") @db.Date

  school    School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  framework FrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Restrict)

  rounds     EvaluationRound[]
  agreements PerformanceAgreement[]
  reports    Report[]

  // PA uniqueness per (school, year, framework) is a partial unique index
  // `evaluation_cycle_pa_uk` (DPA may repeat) — constraints migration
  @@index([schoolId, fiscalYear])
  @@map("evaluation_cycle")
}

/// Configurable 1..n per cycle. The framework's formal PA evaluation is once per
/// fiscal year, but salary review runs twice — so the count is DATA. Nothing in
/// this schema caps it at 2.
model EvaluationRound {
  id          String      @id @default(uuid()) @db.Uuid
  cycleId     String      @map("cycle_id") @db.Uuid
  roundNumber Int         @map("round_number")
  purpose     String
  periodStart DateTime    @map("period_start") @db.Date
  periodEnd   DateTime    @map("period_end") @db.Date
  status      RoundStatus @default(planned)

  cycle EvaluationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  workloadDeclarations WorkloadDeclaration[]
  assignments          EvaluationAssignment[]
  reports              Report[]

  @@unique([cycleId, roundNumber])
  @@map("evaluation_round")
}

/// PA1 — the agreement itself, one per person per cycle.
model PerformanceAgreement {
  id          String          @id @default(uuid()) @db.Uuid
  schoolId    String          @map("school_id") @db.Uuid
  cycleId     String          @map("cycle_id") @db.Uuid
  personnelId String          @map("personnel_id") @db.Uuid
  formVariant String          @map("form_variant") // PA1_s | PA1_bs
  status      AgreementStatus @default(draft)
  submittedAt DateTime?       @map("submitted_at")

  school    School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  cycle     EvaluationCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  personnel PersonnelProfile @relation(fields: [personnelId], references: [id], onDelete: Restrict)

  challenges           AgreementChallenge[]
  workloadDeclarations WorkloadDeclaration[]
  assignments          EvaluationAssignment[]

  @@unique([cycleId, personnelId])
  @@map("performance_agreement")
}

/// ภาระงาน — pass/fail gate, deliberately NOT an indicator score.
/// Framework rule: workload not met ⇒ overall fail regardless of percentage.
model WorkloadDeclaration {
  id               String   @id @default(uuid()) @db.Uuid
  agreementId      String   @map("agreement_id") @db.Uuid
  roundId          String   @map("round_id") @db.Uuid
  workloadMet      Boolean  @map("workload_met")
  notes            String?  @db.Text
  declaredByUserId String   @map("declared_by_user_id") @db.Uuid
  declaredAt       DateTime @default(now()) @map("declared_at")

  agreement  PerformanceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  round      EvaluationRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  declaredBy UserAccount          @relation(fields: [declaredByUserId], references: [id], onDelete: Restrict)

  @@unique([agreementId, roundId])
  @@map("workload_declaration")
}

/// ประเด็นท้าทาย — the person's planned method + targets for ส่วนที่ 2.
model AgreementChallenge {
  id          String @id @default(uuid()) @db.Uuid
  agreementId String @map("agreement_id") @db.Uuid
  /// CCR-015: the framework's วิธีดำเนินการ indicator (T-C.1 / A-C.1). One
  /// challenge row per agreement — the PA1 form has exactly one ประเด็นท้าทาย,
  /// and this row carries all three scored texts, so the unique key below
  /// enforces "one per agreement" rather than merely de-duplicating indicators.
  indicatorId String @map("indicator_id") @db.Uuid
  /// ประเด็นท้าทาย เรื่อง … — added CCR-015. Required: a plan with no subject is
  /// not a challenge. Safe as NOT NULL because this table had zero rows in every
  /// environment (nothing could create one until CCR-015).
  title              String  @db.VarChar(500)
  methodPlan         String  @map("method_plan") @db.Text
  quantitativeTarget String? @map("quantitative_target") @db.Text
  qualitativeTarget  String? @map("qualitative_target") @db.Text
  /// Both appear on the PA1 form; neither is scored.
  targetGroup        String? @map("target_group") @db.VarChar(500)
  periodNote         String? @map("period_note") @db.VarChar(500)

  agreement PerformanceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  indicator Indicator            @relation(fields: [indicatorId], references: [id], onDelete: Restrict)

  @@unique([agreementId, indicatorId])
  @@map("agreement_challenge")
}

// ─────────────────── evidence (upload once, reuse) ───────────────────

/// A logical evidence item owned by one person. Reused across indicators and
/// reports through mappings — never copied per use.
/// Lifecycle (CCR-002): draft → active once the first file upload completes.
model Evidence {
  id                  String               @id @default(uuid()) @db.Uuid
  ownerPersonId       String               @map("owner_person_id") @db.Uuid
  controllerAreaId    String?              @map("controller_area_id") @db.Uuid
  originSchoolId      String               @map("origin_school_id") @db.Uuid
  uploadedByUserId    String               @map("uploaded_by_user_id") @db.Uuid
  categoryId          String               @map("category_id") @db.Uuid
  kind                EvidenceKind         @default(file)
  title               String               @db.VarChar(300)
  description         String?              @db.Text
  linkUrl             String?              @map("link_url") @db.Text
  noteText            String?              @map("note_text") @db.Text
  status              EvidenceStatus       @default(draft)
  capturedAt          DateTime?            @map("captured_at")
  performedFrom       DateTime?            @map("performed_from") @db.Date
  performedTo         DateTime?            @map("performed_to") @db.Date
  performedDateSource PerformedDateSource? @map("performed_date_source")
  academicYearBe      Int?                 @map("academic_year_be")
  semester            Int?
  containsLearners    ContainsLearners     @default(unknown) @map("contains_learners")
  /// CCR-024: null while an item uploaded on the owner's behalf awaits their acceptance.
  ownerAcceptedAt     DateTime?            @map("owner_accepted_at")
  /// The offline client's id for this item; UNIQUE per owner so an outbox replay
  /// cannot create a duplicate (constraints migration).
  clientUuid          String?              @map("client_uuid") @db.Uuid
  version             Int                  @default(1)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at") // soft delete; storage GC is async

  owner        Person           @relation(fields: [ownerPersonId], references: [id], onDelete: Restrict)
  controller   Area?            @relation(fields: [controllerAreaId], references: [id], onDelete: Restrict)
  originSchool School           @relation(fields: [originSchoolId], references: [id], onDelete: Restrict)
  uploadedBy   UserAccount      @relation("EvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  category     EvidenceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// FR-028 / CCR-027: hidden-instruction signs the latest analysis found, for the
  /// content hashed as injectionInputSha256. Cleared by a school admin for that hash.
  injectionReasons          String[]  @default([]) @map("injection_reasons")
  injectionInputSha256      String?   @map("injection_input_sha256")
  injectionClearedSha256    String?   @map("injection_cleared_sha256")
  injectionClearedAt        DateTime? @map("injection_cleared_at")
  injectionClearedByUserId  String?   @map("injection_cleared_by_user_id") @db.Uuid

  files          EvidenceFile[]
  mappings       EvidenceIndicatorMapping[]
  analyses       EvidenceAnalysis[]
  segments       ContentSegment[]
  suggestions    AiSuggestion[]
  sectionRefs    ReportSectionRef[]
  uploadSessions UploadSession[]

  @@unique([ownerPersonId, clientUuid], map: "evidence_owner_client_uuid_uk")
  @@index([originSchoolId, deletedAt])
  @@index([ownerPersonId, deletedAt])
  @@map("evidence")
}

/// File METADATA only. Bytes live in S3-compatible storage (ADR-0013) and never enter the DB or
/// pass through the API process (SEC-UPL-1). storageUri/storageProvider are never
/// exposed in any API response — the client only ever gets a short-lived presigned URL.
model EvidenceFile {
  id               String          @id @default(uuid()) @db.Uuid
  evidenceId       String          @map("evidence_id") @db.Uuid
  storageProvider  StorageProvider @default(s3_compatible) @map("storage_provider")
  storageUri       String          @map("storage_uri") @db.Text
  contentType      String          @map("content_type")
  byteSize         BigInt          @map("byte_size")
  checksumSha256   String          @map("checksum_sha256")
  durationSeconds  Int?            @map("duration_seconds") // null until the worker probes (CCR-002)
  durationMs       Int?            @map("duration_ms")
  role             FileRole        @default(original)
  parentFileId     String?         @map("parent_file_id") @db.Uuid
  /// Set when the worker re-hashed the stored object and it matched checksum_sha256.
  sha256VerifiedAt DateTime?       @map("sha256_verified_at")
  /// CCR-026: the owner's earlier file with the same verified bytes (a warning only).
  duplicateOfFileId String?        @map("duplicate_of_file_id") @db.Uuid
  pageCount        Int?            @map("page_count")
  width            Int?
  height           Int?
  mediaState       MediaState      @default(uploading) @map("media_state")
  originalFilename String          @map("original_filename") @db.VarChar(255)
  scanStatus       ScanStatus      @default(pending) @map("scan_status")
  /// Receipt for a REAL scan: set only when clamd returned a verdict (ADR-0009).
  /// Null therefore means "no scanner has ever read these bytes" — which is true
  /// of `unscanned` rows, of files blocked for size without being read, and of
  /// every `clean` row written by the filename stub CCR-012 deleted. Without this
  /// column those stub rows are indistinguishable from a genuine pass, which is
  /// exactly why migration 20260718220000 could not safely backfill them.
  /// Also dates the verdict, so a signature-update sweep can target `scanned_at
  /// < <date>`. Deliberately internal: not in openapi, so this stays additive.
  scannedAt        DateTime?       @map("scanned_at")
  uploadedAt       DateTime        @default(now()) @map("uploaded_at")

  evidence      Evidence       @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  uploadSession UploadSession?
  duplicateOf   EvidenceFile?  @relation("FileDuplicate", fields: [duplicateOfFileId], references: [id], onDelete: SetNull)
  duplicates    EvidenceFile[] @relation("FileDuplicate")
  segments      ContentSegment[]

  @@index([evidenceId])
  @@index([scanStatus])
  @@index([checksumSha256])
  /// The rescan sweep's query: "never really scanned", oldest first.
  @@index([scannedAt])
  @@map("evidence_file")
}

// ─────────────────── worker / transactional outbox (SEIP-WORKER-001) ───────────────────

/// Domain events written in the same transaction as the domain change
/// (events.yaml + module-boundaries rule 4). Worker publishes / fans out;
/// `publishedAt` null means still pending dispatch.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type")
  schemaVersion Int       @default(1) @map("schema_version")
  schoolId      String?   @map("school_id") @db.Uuid
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  requestId     String?   @map("request_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  /// Dispatch lease (ADR-0012 §3): a claimed row is invisible to other
  /// dispatchers until it is published, failed (lease released), or this passes.
  lockedUntil   DateTime? @map("locked_until")
  lastError     String?   @map("last_error") @db.Text

  @@index([publishedAt, occurredAt])
  @@index([eventType, publishedAt])
  @@map("outbox_event")
}

/// Async work units (scan, duration probe, GC, future AI/report jobs).
/// One worker process claims pending rows — no second queue runner.
model WorkerJob {
  id          String    @id @default(uuid()) @db.Uuid
  jobType     String    @map("job_type")
  payload     Json
  status      String    @default("pending") // pending | running | done | failed
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at")
  lockedAt    DateTime? @map("locked_at")
  completedAt DateTime? @map("completed_at")
  lastError   String?   @map("last_error") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@index([jobType, status])
  @@map("worker_job")
}

// ─────────────────── governed evidence↔indicator mapping ───────────────────

/// The heart of "upload once, reuse through governed mappings". M:N with a status
/// machine so a human confirms what counts toward which indicator. AI suggestions
/// (Sprint 2) will land here as mappingSource=ai_suggested, still requiring confirmation.
model EvidenceIndicatorMapping {
  id                     String         @id @default(uuid()) @db.Uuid
  schoolId               String         @map("school_id") @db.Uuid // the owner's school when confirmed (FR-051; = origin unless they moved); validator queue
  evidenceId             String         @map("evidence_id") @db.Uuid
  indicatorId            String         @map("indicator_id") @db.Uuid
  frameworkVersionId     String         @map("framework_version_id") @db.Uuid
  mappingSource          MappingSource  @map("mapping_source")
  status                 MappingStatus  @default(owner_confirmed)
  aiSuggestionId         String?        @map("ai_suggestion_id") @db.Uuid
  note                   String?        @db.Text
  ownerConfirmedByUserId String         @map("owner_confirmed_by_user_id") @db.Uuid
  ownerConfirmedAt       DateTime       @default(now()) @map("owner_confirmed_at")
  validatedByUserId      String?        @map("validated_by_user_id") @db.Uuid
  validatedAt            DateTime?      @map("validated_at")
  validatorRole          ValidatorRole? @map("validator_role")
  returnNote             String?        @map("return_note") @db.Text
  locatorSnapshot        Json?          @map("locator_snapshot")
  version                Int            @default(1)
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at")

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  evidence         Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  indicator        Indicator        @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  frameworkVersion FrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Restrict)
  ownerConfirmedBy UserAccount      @relation("MappingOwnerConfirmer", fields: [ownerConfirmedByUserId], references: [id], onDelete: Restrict)
  validatedBy      UserAccount?     @relation("MappingValidator", fields: [validatedByUserId], references: [id], onDelete: Restrict)

  sectionRefs ReportSectionRef[]

  // One live mapping per (evidence, indicator, framework version): the partial
  // unique index `evidence_indicator_mapping_active_uk` WHERE status <> 'revoked'
  // — constraints migration.
  @@index([indicatorId, status])
  @@index([schoolId, status])
  @@index([evidenceId, status])
  @@map("evidence_indicator_mapping")
}

/// Resumable upload (ADR-0016 §5, CCR-017): single PUT ≤16 MiB, S3 multipart above.
/// The server completes multipart uploads from its own ListParts.
model UploadSession {
  id               String         @id @default(uuid()) @db.Uuid
  evidenceId       String         @map("evidence_id") @db.Uuid
  fileId           String         @unique @map("file_id") @db.Uuid
  protocol         UploadProtocol
  s3UploadId       String?        @map("s3_upload_id")
  partSize         Int            @map("part_size")
  partCount        Int            @map("part_count")
  byteSize         BigInt         @map("byte_size")
  checksumSha256   String         @map("checksum_sha256")
  status           UploadStatus   @default(open)
  createdByUserId  String         @map("created_by_user_id") @db.Uuid
  expiresAt        DateTime       @map("expires_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  evidence  Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  file      EvidenceFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy UserAccount  @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@map("upload_session")
}

/// Idempotency-Key replay store (CCR-017): (actor, key) → the first response,
/// kept 24 h. A retry with the same body replays it; a different body fails IDEMP-001.
model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  key         String   @db.Uuid
  operationId String   @map("operation_id")
  requestHash String   @map("request_hash")
  statusCode  Int      @map("status_code")
  response    Json
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  actor UserAccount @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, key])
  @@index([expiresAt])
  @@map("idempotency_key")
}

// ─────────────────── committee & per-evaluator scores ───────────────────

/// One evaluatee, one round.
model EvaluationAssignment {
  id                   String           @id @default(uuid()) @db.Uuid
  schoolId             String           @map("school_id") @db.Uuid
  roundId              String           @map("round_id") @db.Uuid
  evaluateePersonnelId String           @map("evaluatee_personnel_id") @db.Uuid
  agreementId          String?          @map("agreement_id") @db.Uuid
  status               AssignmentStatus @default(pending)

  school    School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  round     EvaluationRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  evaluatee PersonnelProfile      @relation(fields: [evaluateePersonnelId], references: [id], onDelete: Restrict)
  agreement PerformanceAgreement? @relation(fields: [agreementId], references: [id], onDelete: Restrict)

  committee CommitteeMember[]
  scores    IndicatorScore[]
  results   RoundResult[]

  @@unique([roundId, evaluateePersonnelId])
  @@index([schoolId, status])
  @@map("evaluation_assignment")

  comments AssignmentComment[] // CCR-028
}

/// Exactly 3 per assignment (ว9 p.74 / ว10): ผอ.สถานศึกษา as chair + 2 qualified members.
/// The "exactly 3" rule is enforced at scoring time (SCORE-001), not at insert time,
/// so a committee can be assembled seat by seat.
model CommitteeMember {
  id              String        @id @default(uuid()) @db.Uuid
  assignmentId    String        @map("assignment_id") @db.Uuid
  evaluatorUserId String        @map("evaluator_user_id") @db.Uuid
  committeeRole   CommitteeRole @map("committee_role")
  seatNumber      Int           @map("seat_number") // 1..3 — CHECK in constraints.sql

  assignment EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  evaluator  UserAccount          @relation(fields: [evaluatorUserId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, evaluatorUserId])
  @@unique([assignmentId, seatNumber])
  @@map("committee_member")
}

/// PER-EVALUATOR score for one indicator. Grain: (assignment, indicator, evaluator).
///
/// DB-001 decision (from the DB-000 review, observation #1): the design had separate
/// IndicatorScore and ChallengeScore tables with an identical grain. They are ONE table
/// here — the indicator itself carries indicatorKind, so a discriminator column would
/// have duplicated it. Standard vs challenge scoring differs only in how points are
/// derived, which is framework data (ScoreWeight + Indicator.maxPoints), not structure.
model IndicatorScore {
  id              String   @id @default(uuid()) @db.Uuid
  assignmentId    String   @map("assignment_id") @db.Uuid
  indicatorId     String   @map("indicator_id") @db.Uuid
  evaluatorUserId String   @map("evaluator_user_id") @db.Uuid
  rubricLevel     Int      @map("rubric_level") // 1..4 — CHECK in constraints.sql
  pointsAwarded   Decimal? @map("points_awarded") @db.Decimal(6, 2)
  comment         String?  @db.Text
  scoredAt        DateTime @default(now()) @map("scored_at")

  assignment EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  indicator  Indicator            @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  evaluator  UserAccount          @relation(fields: [evaluatorUserId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, indicatorId, evaluatorUserId])
  @@index([assignmentId, evaluatorUserId])
  @@map("indicator_score")
}

/// Per-evaluator rollup. The framework's pass rule is "≥70% from EACH evaluator"
/// (ว9 p.74) — so this is one row per evaluator, and the overall verdict is a
/// property of the SET of rows, never a single averaged number.
/// passedIndividualThreshold is a GENERATED column (constraints.sql) so it can
/// never disagree with totalPercent — the app cannot write it.
model RoundResult {
  id                        String   @id @default(uuid()) @db.Uuid
  assignmentId              String   @map("assignment_id") @db.Uuid
  evaluatorUserId           String   @map("evaluator_user_id") @db.Uuid
  part1Percent              Decimal  @map("part1_percent") @db.Decimal(5, 2)
  part2Percent              Decimal  @map("part2_percent") @db.Decimal(5, 2)
  totalPercent              Decimal  @map("total_percent") @db.Decimal(5, 2)
  passedWorkloadGate        Boolean  @map("passed_workload_gate")
  passedIndividualThreshold Boolean? @map("passed_individual_threshold") // GENERATED — see constraints.sql
  status                    String   @default("computed")
  computedAt                DateTime @default(now()) @map("computed_at")

  assignment EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  evaluator  UserAccount          @relation(fields: [evaluatorUserId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, evaluatorUserId])
  @@map("round_result")
}

// ─────────────────────── reports & approvals ───────────────────────

/// PA1/PA2/PA3 × ส/บส instance. Stores structured payload + references; the official
/// layout is a Protected Artifact and report contracts are deferred to v0.2.
model Report {
  id                String       @id @default(uuid()) @db.Uuid
  schoolId          String       @map("school_id") @db.Uuid
  cycleId           String       @map("cycle_id") @db.Uuid
  roundId           String?      @map("round_id") @db.Uuid
  subjectPersonnelId String      @map("subject_personnel_id") @db.Uuid
  templateCode      String       @map("template_code")
  status            ReportStatus @default(draft)
  payload           Json
  generatedAt       DateTime     @default(now()) @map("generated_at")

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  cycle    EvaluationCycle  @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  round    EvaluationRound? @relation(fields: [roundId], references: [id], onDelete: Restrict)
  subject  PersonnelProfile @relation(fields: [subjectPersonnelId], references: [id], onDelete: Restrict)

  sectionRefs ReportSectionRef[]
  approvals   Approval[]

  @@index([schoolId, cycleId])
  @@map("report")
}

/// Cites evidence BY REFERENCE. A report never embeds file bytes — that is what
/// makes "upload once" hold across every report that reuses the same evidence.
model ReportSectionRef {
  id         String  @id @default(uuid()) @db.Uuid
  reportId   String  @map("report_id") @db.Uuid
  evidenceId String? @map("evidence_id") @db.Uuid
  mappingId  String? @map("mapping_id") @db.Uuid
  sectionKey String  @map("section_key")
  sortOrder  Int     @map("sort_order")

  report   Report                    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  evidence Evidence?                 @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  mapping  EvidenceIndicatorMapping? @relation(fields: [mappingId], references: [id], onDelete: Restrict)

  @@index([reportId, sectionKey])
  @@map("report_section_ref")
}

model Approval {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  reportId       String           @map("report_id") @db.Uuid
  approverUserId String           @map("approver_user_id") @db.Uuid
  stepCode       String           @map("step_code")
  decision       ApprovalDecision @default(pending)
  comment        String?          @db.Text
  decidedAt      DateTime?        @map("decided_at")

  school   School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  report   Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  approver UserAccount @relation(fields: [approverUserId], references: [id], onDelete: Restrict)

  @@index([reportId, decision])
  @@map("approval")
}

// ─────────────────────────── audit ───────────────────────────

/// Append-only trail (DB-000 decision: event-sourcing lite over temporal tables).
/// No FK from domain rows: an audit event must survive the hard deletion of what it
/// describes. The app role is DENIED update/delete on this table (constraints.sql) —
/// accountability that depends on discipline is not accountability.
/// SEC-PDPA-2: beforeState/afterState use a field allowlist — learner content must
/// never be duplicated into audit rows.
model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String?  @map("school_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  beforeState  Json?    @map("before_state")
  afterState   Json?    @map("after_state")
  requestId    String?  @map("request_id") @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at")

  @@index([schoolId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_event")
}

// ── P3 in-country AI (ADR-0010, contract 4.0.0 "analysis" tag) ──
// AI only suggests: a suggestion becomes a mapping only when the owner accepts it
// (acceptSuggestion → owner_confirmed, source ai_accepted). Until the GPU tier
// exists every analysis finishes `degraded` on the local_heuristic floor and its
// suggestions are provisional.

enum AnalysisStatus {
  queued
  extracting
  perceiving
  mapping
  validating
  succeeded
  degraded
  failed
}

model EvidenceAnalysis {
  id                String         @id @default(uuid()) @db.Uuid
  evidenceId        String         @map("evidence_id") @db.Uuid
  status            AnalysisStatus @default(queued)
  stage             String?
  provisional       Boolean        @default(true)
  errorCode         String?        @map("error_code")
  requestedByUserId String?        @map("requested_by_user_id") @db.Uuid // null = automatic after verify + scan
  createdAt         DateTime       @default(now()) @map("created_at")
  finishedAt        DateTime?      @map("finished_at")

  evidence    Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  segments    ContentSegment[]
  suggestions AiSuggestion[]

  @@index([evidenceId, createdAt])
  @@map("evidence_analysis")
}

enum SegmentKind {
  page_block
  transcript
  keyframe
  image_caption
  sheet_range
  note
  link_text
}

/// A locator target: a page block, a transcript span, a keyframe. Extracted text
/// is evidence content — personal data, never logged, never sent abroad.
model ContentSegment {
  id             String      @id @default(uuid()) @db.Uuid
  evidenceId     String      @map("evidence_id") @db.Uuid
  evidenceFileId String      @map("evidence_file_id") @db.Uuid
  analysisId     String      @map("analysis_id") @db.Uuid
  kind           SegmentKind
  ordinal        Int
  page           Int?
  tStartMs       Int?        @map("t_start_ms")
  tEndMs         Int?        @map("t_end_ms")
  frameMs        Int?        @map("frame_ms")
  bbox           Json?
  text           String?     @db.Text
  confidence     Float?
  createdAt      DateTime    @default(now()) @map("created_at")

  evidence Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  file     EvidenceFile     @relation(fields: [evidenceFileId], references: [id], onDelete: Cascade)
  analysis EvidenceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([evidenceId, analysisId, ordinal])
  @@map("content_segment")
}

enum SuggestionStatus {
  open
  accepted
  rejected
  superseded
  needs_review
}

enum SuggestionBand {
  clear
  likely
  possible
}

enum SuggestionSupport {
  supports
  partially_supports
}

enum SuggestionRejectReason {
  not_relevant
  wrong_indicator
  weak_evidence
  wrong_period
  duplicate
  other
}

model AiSuggestion {
  id                 String            @id @default(uuid()) @db.Uuid
  evidenceId         String            @map("evidence_id") @db.Uuid
  analysisId         String            @map("analysis_id") @db.Uuid
  indicatorId        String            @map("indicator_id") @db.Uuid
  frameworkVersionId String            @map("framework_version_id") @db.Uuid
  band               SuggestionBand
  support            SuggestionSupport @default(supports)
  calibratedP        Float?            @map("calibrated_p")
  rationaleTh        String?           @map("rationale_th") @db.Text
  /// Server-validated locators only (Locator[] in the contract).
  locators           Json              @default("[]")
  provisional        Boolean           @default(true)
  status             SuggestionStatus  @default(open)
  modelLabel         String?           @map("model_label")
  promptVersion      String?           @map("prompt_version")
  inputSha256        String?           @map("input_sha256")
  supersededById     String?           @map("superseded_by_id") @db.Uuid
  decidedByUserId    String?           @map("decided_by_user_id") @db.Uuid
  decidedAt          DateTime?         @map("decided_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  evidence         Evidence             @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  analysis         EvidenceAnalysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  indicator        Indicator            @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  frameworkVersion FrameworkVersion     @relation(fields: [frameworkVersionId], references: [id], onDelete: Restrict)
  feedback         SuggestionFeedback[]

  @@index([evidenceId, status])
  @@map("ai_suggestion")
}

/// Why the owner rejected a suggestion — feeds calibration (FR-042).
model SuggestionFeedback {
  id           String                 @id @default(uuid()) @db.Uuid
  suggestionId String                 @map("suggestion_id") @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  reasonCode   SuggestionRejectReason @map("reason_code")
  note         String?                @db.Text
  createdAt    DateTime               @default(now()) @map("created_at")

  suggestion AiSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([suggestionId])
  @@map("suggestion_feedback")
}

// ── P4 notifications (FR-100/102, ADR-0016 §7) ──
// The in-app inbox is the source of truth for every channel. A push carries no
// content, only a sync ping (FR-101). Rows are made by the outbox dispatcher
// from domain events, once per (event, recipient).

enum NotificationKind {
  suggestions_ready
  processing_failed
  mapping_returned
  mapping_validated
  deadline
  export_ready
  transfer_approved
  committee_comment
  subject_request_received
  subject_request_updated
}

model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  kind          NotificationKind
  titleTh       String           @map("title_th")
  bodyTh        String?          @map("body_th")
  entityType    String?          @map("entity_type")
  entityId      String?          @map("entity_id") @db.Uuid
  route         String?
  sourceEventId String?          @map("source_event_id") @db.Uuid
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@unique([sourceEventId, userId])
  @@index([userId, createdAt])
  @@map("notification")
}

model NotificationPreference {
  userId     String   @id @map("user_id") @db.Uuid
  push       Boolean  @default(true)
  email      Boolean  @default(false)
  quietStart String?  @map("quiet_start")
  quietEnd   String?  @map("quiet_end")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("notification_preference")
}

// ── CCR-028 (FR-064): committee comments per indicator, with the evaluatee's replies.
// Plain text; no score, no status change.

enum AssignmentCommentKind {
  comment
  request_info
  reply
}

enum AssignmentCommentAuthorRole {
  committee
  director
  evaluatee
}

model AssignmentComment {
  id           String                      @id @default(uuid()) @db.Uuid
  assignmentId String                      @map("assignment_id") @db.Uuid
  schoolId     String                      @map("school_id") @db.Uuid // the assignment's school (RLS)
  indicatorId  String                      @map("indicator_id") @db.Uuid
  kind         AssignmentCommentKind
  body         String                      @db.Text
  parentId     String?                     @map("parent_id") @db.Uuid
  authorUserId String                      @map("author_user_id") @db.Uuid
  authorRole   AssignmentCommentAuthorRole @map("author_role")
  createdAt    DateTime                    @default(now()) @map("created_at")

  assignment EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_comment_assignment_fk")
  parent     AssignmentComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_comment_parent_fk")
  replies    AssignmentComment[]  @relation("CommentReplies")

  @@index([assignmentId, indicatorId, createdAt])
  @@map("assignment_comment")
}

// ── P5 exports (ADR-0017; contract 4.0.0 "exports") ──
// A package is built by the worker into object storage, held for a short time,
// then removed. person_id is whose data it is; requested_by may differ (an
// admin exporting a staff member's portfolio needs step-up, permissions min_acr).

enum ExportKind {
  dpa_pack
  pa2_workbook
  portfolio_portable
}

enum ExportStatus {
  queued
  preflight_failed
  building
  ready
  failed
  expired
}

model ExportPackage {
  id                String       @id @default(uuid()) @db.Uuid
  kind              ExportKind
  personId          String       @map("person_id") @db.Uuid
  schoolId          String       @map("school_id") @db.Uuid // the school it was requested at (admin listing, RLS)
  requestedByUserId String       @map("requested_by_user_id") @db.Uuid
  status            ExportStatus @default(queued)
  preflight         Json         @default("[]")
  storageUri        String?      @map("storage_uri")
  byteSize          BigInt?      @map("byte_size")
  sha256            String?
  expiresAt         DateTime?    @map("expires_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  finishedAt        DateTime?    @map("finished_at")

  @@index([personId, createdAt])
  @@index([schoolId, createdAt])
  @@map("export_package")
}

// ── FR-117 data-subject requests (CCR-029) ──
// Filed by the person about their own data, decided by the DPO of the area the
// filing school belongs to. due_at is received_at + 30 days (NFR-PDPA-05,
// unverified — shown as a warning, never enforced).
enum SubjectRequestType {
  access
  portability
  correction
  erasure
  restriction
  objection
}

enum SubjectRequestStatus {
  received
  fulfilling
  approved
  completed
  rejected
}

model SubjectRequest {
  id                String               @id @default(uuid()) @db.Uuid
  personId          String               @map("person_id") @db.Uuid
  requestedByUserId String               @map("requested_by_user_id") @db.Uuid
  schoolId          String               @map("school_id") @db.Uuid // the school it was filed from
  areaId            String               @map("area_id") @db.Uuid // whose DPO decides (RLS)
  requestType       SubjectRequestType   @map("request_type")
  status            SubjectRequestStatus @default(received)
  details           String?              @db.Text
  receivedAt        DateTime             @default(now()) @map("received_at")
  dueAt             DateTime             @map("due_at")
  decisionNote      String?              @map("decision_note") @db.Text
  decidedAt         DateTime?            @map("decided_at")
  decidedByUserId   String?              @map("decided_by_user_id") @db.Uuid
  completedAt       DateTime?            @map("completed_at")
  exportId          String?              @unique @map("export_id") @db.Uuid

  @@index([personId, receivedAt])
  @@index([areaId, status, dueAt])
  @@map("subject_request")
}
