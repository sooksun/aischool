# Copy to .env and fill in. Real values are secrets — never commit .env (SEC-REPO-1).
# Local dev values that match docker-compose.yml are shown; on-prem/staging uses
# .env.staging.example → .env.staging with docker-compose.staging.yml (SEIP-OPS-003).
# Ops procedures: docs/project/ops-runbook.md

# --- MySQL 8 — Laragon-managed local server (ADR-0008) ---
# root / no password is Laragon's stock configuration; create the database once:
#   mysql -u root -e "CREATE DATABASE IF NOT EXISTS seip CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"
DATABASE_URL="mysql://root@localhost:3306/seip"

# --- Object storage — MinIO on-prem, S3-compatible API only (ADR-0005) ---
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="seip-evidence"
S3_ACCESS_KEY="seip_dev"
S3_SECRET_KEY="seip_dev_only_change_me"
S3_REGION="us-east-1"

# --- apps/api ---
JWT_SECRET="dev-only-secret-change-me-min-32-chars-long"
# 3011 = default target of the web dev proxy (apps/web/vite.config.ts) — keep them in sync
PORT=3011
NODE_ENV=development
# TRUST_PROXY=true   # set when behind nginx so login rate-limit uses real client IP
# LOGIN_RATE_WINDOW_MS=900000
# LOGIN_RATE_MAX_PER_IP=40
# LOGIN_RATE_MAX_PER_EMAIL=12

# --- apps/worker (npm run dev:worker) ---
WORKER_POLL_MS=2000
WORKER_GC_AFTER_DAYS=7

# --- apps/web (dev only) ---
# Vite proxies /api → this target (see apps/web/vite.config.ts). Staging uses
# same-origin /api behind nginx instead (VITE_API_BASE empty at build time).
# VITE_API_PROXY_TARGET="http://localhost:3001"
