# Copy to .env and fill in. Real values are secrets — never commit .env (SEC-REPO-1).
# Local dev values that match docker-compose.yml are shown; on-prem uses real ones.

# PostgreSQL (port 5433 in dev to avoid clashing with a Laragon-managed instance)
DATABASE_URL="postgresql://seip:seip_dev_only@localhost:5433/seip?schema=public"

# Object storage — MinIO on-prem, S3-compatible API only (ADR-0005)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="seip-evidence"
S3_ACCESS_KEY="seip_dev"
S3_SECRET_KEY="seip_dev_only_change_me"
S3_REGION="us-east-1"
