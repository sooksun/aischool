# Copy to .env and fill in. Real values are secrets — never commit .env (SEC-REPO-1).
# Local dev values that match docker-compose.yml are shown; on-prem/staging uses
# .env.staging.example → .env.staging with docker-compose.staging.yml (SEIP-OPS-003).
# Ops procedures: docs/project/ops-runbook.md

# --- PostgreSQL 18 + pgvector (ADR-0012) — `docker compose up -d` ---
# Two roles, neither superuser (scripts/db/bootstrap-roles.sql runs on first boot):
#   seip_app       the API/worker/tests — DML only
#   seip_migrator  owns the schema; used by `npm run db:migrate` only
DATABASE_URL="postgresql://seip_app:seip_app_dev@localhost:5432/seip"
MIGRATE_DATABASE_URL="postgresql://seip_migrator:seip_migrator_dev@localhost:5432/seip"

# --- Object storage — S3 API only (ADR-0013): SeaweedFS in dev, S3 Bangkok in prod ---
S3_ENDPOINT="http://localhost:8333"
S3_BUCKET="seip-evidence"
S3_ACCESS_KEY="seip_ci"
S3_SECRET_KEY="seip_ci_only_change_me"
S3_REGION="us-east-1"

# --- apps/api ---
JWT_SECRET="dev-only-secret-change-me-min-32-chars-long"
# 3011 = default target of the web dev proxy (apps/web/vite.config.ts) — keep them in sync
PORT=3011
NODE_ENV=development
# v2 committee scoring + PA reports (ADR-0017, CCR-017). Default off: the routes
# are compiled but not registered. Dev, tests and CI turn them on so the frozen
# code keeps working. The web build reads the same variable (apps/web/vite.config.ts)
# and hides the scoring and report screens when it is off.
FEATURE_SCORING=true
# TRUST_PROXY=true   # set when behind nginx so login rate-limit uses real client IP
# LOGIN_RATE_WINDOW_MS=900000
# LOGIN_RATE_MAX_PER_IP=40
# LOGIN_RATE_MAX_PER_EMAIL=12

# --- apps/worker (npm run dev:worker) ---
WORKER_POLL_MS=2000
WORKER_GC_AFTER_DAYS=7

# --- apps/web (dev only) ---
# Vite proxies /api → this target (see apps/web/vite.config.ts). Staging uses
# same-origin /api behind nginx instead (VITE_API_BASE empty at build time).
# VITE_API_PROXY_TARGET="http://localhost:3001"
