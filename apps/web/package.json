{
  "name": "@seip/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SEIP evidence-submission SPA — implements docs/architecture/ux/evidence-submission-flow.md (S1-S7) against the real API (module-boundaries.md).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
