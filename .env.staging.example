# SEIP staging / on-prem secrets template (SEIP-OPS-003).
# Copy to .env.staging (gitignored) and fill real values.
#   cp .env.staging.example .env.staging
# Never commit .env.staging (SEC-REPO-1).
#
# Generate secrets, e.g.:
#   openssl rand -base64 32

# --- MySQL 8 (ADR-0008) ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_USER=seip
MYSQL_PASSWORD=CHANGE_ME_strong_password
MYSQL_DATABASE=seip

# --- JWT (apps/api) — min 32 characters ---
JWT_SECRET=CHANGE_ME_to_at_least_32_characters_long

# Behind edge nginx (SEIP-OPS-004): trust X-Forwarded-For for login rate limits
TRUST_PROXY=true
# Optional overrides (defaults: 15m window, 40/IP, 12/email)
# LOGIN_RATE_WINDOW_MS=900000
# LOGIN_RATE_MAX_PER_IP=40
# LOGIN_RATE_MAX_PER_EMAIL=12

# --- MinIO / S3-compatible (ADR-0005) ---
# Inside compose, api uses http://minio:9000; do not put public URLs here.
S3_ACCESS_KEY=CHANGE_ME_minio_access
S3_SECRET_KEY=CHANGE_ME_minio_secret_min_8_chars
S3_BUCKET=seip-evidence
S3_REGION=us-east-1

# --- Worker (apps/worker) ---
WORKER_POLL_MS=2000
WORKER_GC_AFTER_DAYS=7

# --- Web build ---
# Empty = browser calls same-origin /api (edge nginx proxies to api). Preferred.
VITE_API_BASE=
