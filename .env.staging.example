# SEIP staging / on-prem secrets template (SEIP-OPS-003).
# Copy to .env.staging (gitignored) and fill real values.
#   cp .env.staging.example .env.staging
# Never commit .env.staging (SEC-REPO-1).
#
# Generate secrets, e.g.:
#   openssl rand -base64 32

# --- PostgreSQL 18 (ADR-0012) — three distinct passwords ---
# postgres: admin only (first-boot role bootstrap, backup verify scratch DBs)
# seip_migrator: owns the schema, runs migrations (the `migrate` service)
# seip_app: the api/worker — DML only
POSTGRES_PASSWORD=CHANGE_ME_strong_admin_password
POSTGRES_DB=seip
SEIP_MIGRATOR_PASSWORD=CHANGE_ME_strong_migrator_password
SEIP_APP_PASSWORD=CHANGE_ME_strong_app_password

# --- JWT (apps/api) — min 32 characters ---
JWT_SECRET=CHANGE_ME_to_at_least_32_characters_long

# Behind edge nginx (SEIP-OPS-004): trust X-Forwarded-For for login rate limits
TRUST_PROXY=true
# Optional overrides (defaults: 15m window, 40/IP, 12/email)
# LOGIN_RATE_WINDOW_MS=900000
# LOGIN_RATE_MAX_PER_IP=40
# LOGIN_RATE_MAX_PER_EMAIL=12

# --- SeaweedFS / S3 API (ADR-0013) ---
# Inside compose, api uses http://seaweedfs:8333; do not put public URLs here.
S3_ACCESS_KEY=CHANGE_ME_s3_access
S3_SECRET_KEY=CHANGE_ME_s3_secret_min_8_chars
S3_BUCKET=seip-evidence
S3_REGION=us-east-1

# --- Worker (apps/worker) ---
WORKER_POLL_MS=2000
WORKER_GC_AFTER_DAYS=7

# --- v2 committee scoring + PA reports (ADR-0017) ---
# Read by the api at start-up AND baked into the web build. Off for v1.
FEATURE_SCORING=false

# --- Web build ---
# Empty = browser calls same-origin /api (edge nginx proxies to api). Preferred.
VITE_API_BASE=
