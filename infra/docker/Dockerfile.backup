# Backup runner (ADR-0009 sibling; ops-runbook §5).
#
# Deliberately NOT built from the app image: it needs the PostgreSQL 18 client
# tools and the aws CLI, and nothing else. Keeping it separate means the thing that can restore
# your data does not inherit the app's dependency surface.
FROM node:24-bookworm-slim

# pg_dump must be >= the server's major version (ADR-0012: 18), and bookworm
# ships 15 — so the client comes from the PostgreSQL project's apt repository.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg awscli \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-18 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY scripts/ops/backup.mjs scripts/ops/restore.mjs ./scripts/ops/
COPY infra/docker/backup-entrypoint.sh /usr/local/bin/backup-entrypoint.sh
RUN chmod +x /usr/local/bin/backup-entrypoint.sh

# Root is required to write into a bind-mounted host directory whose ownership we
# do not control. The container runs one script on a timer and exposes no port.
ENTRYPOINT ["/usr/local/bin/backup-entrypoint.sh"]
