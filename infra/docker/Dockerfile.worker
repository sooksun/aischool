# SEIP worker image (SEIP-OPS-003) — async jobs against same Postgres + MinIO as API.
# Single process, multiple job types (scan, duration, outbox, GC, future reports/AI).

FROM node:24-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/auth/package.json packages/auth/
COPY packages/backend-shared/package.json packages/backend-shared/
COPY packages/database/package.json packages/database/
RUN npm ci

FROM deps AS build
WORKDIR /app
COPY . .
RUN npx prisma generate
RUN npm run build:libs \
 && npm run build --workspace apps/worker

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/auth/package.json packages/auth/
COPY packages/backend-shared/package.json packages/backend-shared/
COPY packages/database/package.json packages/database/
RUN npm ci --omit=dev
COPY --from=build /app/node_modules/.prisma /app/node_modules/.prisma
COPY --from=build /app/node_modules/@prisma /app/node_modules/@prisma
COPY --from=build /app/packages/backend-shared/dist packages/backend-shared/dist
COPY --from=build /app/packages/auth/dist packages/auth/dist
COPY --from=build /app/packages/database/dist packages/database/dist
COPY --from=build /app/apps/worker/dist apps/worker/dist
COPY packages/backend-shared/package.json packages/backend-shared/
COPY packages/auth/package.json packages/auth/
COPY packages/database/package.json packages/database/
COPY apps/worker/package.json apps/worker/
CMD ["node", "apps/worker/dist/index.js"]
