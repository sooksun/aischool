# SEIP web SPA image (SEIP-OPS-003) — static build served by nginx.
# In staging/on-prem, nginx in front of this container (or this image alone on
# :80 localhost) terminates user traffic and proxies /api to the api service.

FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
RUN npm ci
COPY apps/web apps/web
COPY docs/contracts docs/contracts
# Optional public API base; empty means same-origin /api (nginx reverse proxy).
ARG VITE_API_BASE=
ENV VITE_API_BASE=$VITE_API_BASE
# Same switch as the api (ADR-0017). Must match the api's value, or the v2
# screens either vanish while their routes exist or show up as dead ends.
ARG FEATURE_SCORING=false
ENV FEATURE_SCORING=$FEATURE_SCORING
RUN npm run build --workspace apps/web

FROM nginx:1.27-alpine AS runtime
# Rendered to conf.d/default.conf by the image's envsubst step at start.
COPY infra/docker/nginx-web.conf.template /etc/nginx/templates/default.conf.template
ENV SEIP_API_UPSTREAM=api:3001 \
    SEIP_STORE_UPSTREAM=seaweedfs:8333 \
    S3_BUCKET=seip-evidence
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
