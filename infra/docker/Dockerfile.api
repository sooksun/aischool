# SEIP API image (SEIP-OPS-003) — multi-stage Node build for staging/on-prem.
# Architecture matches ADR-0005: app talks to Postgres + S3-compatible storage
# over the compose network; no evidence bytes land in the image.

FROM node:24-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/auth/package.json packages/auth/
COPY packages/backend-shared/package.json packages/backend-shared/
COPY packages/database/package.json packages/database/
RUN npm ci

FROM deps AS build
WORKDIR /app
COPY . .
RUN npx prisma generate
RUN npm run build:libs \
 && npm run build --workspace apps/api

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/auth/package.json packages/auth/
COPY packages/backend-shared/package.json packages/backend-shared/
COPY packages/database/package.json packages/database/
RUN npm ci --omit=dev
COPY --from=build /app/node_modules/.prisma /app/node_modules/.prisma
COPY --from=build /app/node_modules/@prisma /app/node_modules/@prisma
COPY --from=build /app/packages/backend-shared/dist packages/backend-shared/dist
COPY --from=build /app/packages/auth/dist packages/auth/dist
COPY --from=build /app/packages/database/dist packages/database/dist
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/prisma prisma
COPY packages/backend-shared/package.json packages/backend-shared/
COPY packages/auth/package.json packages/auth/
COPY packages/database/package.json packages/database/
COPY apps/api/package.json apps/api/
EXPOSE 3001
# Migrate then start — staging/on-prem bring-up path (ops-runbook.md)
CMD ["sh", "-c", "npx prisma migrate deploy && node apps/api/dist/index.js"]
