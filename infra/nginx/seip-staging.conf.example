# Example edge reverse proxy for SEIP staging / on-prem (SEIP-OPS-003 + OPS-004).
# Place on the host (or a dedicated nginx/caddy container) that owns public :443.
# Replace:
#   - seip.example.school.th
#   - /etc/ssl/seip/*.pem paths with real certs from your CA or Let's Encrypt
#   - upstream hostnames if not using docker compose network aliases
#
# Architecture (ADR-0005):
#   Client ──TLS──► edge nginx ──► web:80 (SPA)
#                         └──/api/──► api:3001
#   api/web talk to postgres + minio only on the internal compose network.
#
# Do NOT commit real certificates or private keys (SEC-REPO-1).
#
# SEIP-OPS-004 — rate limiting + security headers live HERE (primary).
# apps/api also throttles login per-IP + per-email as defense-in-depth (AUTH-004).

# --- rate limit zones (http context; include this file from nginx.conf http {} or
# paste the two limit_req_zone lines into the main http block if this file is only
# server{} snippets) ---
# limit_req_zone $binary_remote_addr zone=seip_login:10m rate=5r/m;
# limit_req_zone $binary_remote_addr zone=seip_api:10m rate=30r/s;

upstream seip_web {
    server 127.0.0.1:8080;   # docker-compose.staging.yml publishes web on localhost:8080
}

upstream seip_api {
    server 127.0.0.1:3001;   # api published on localhost:3001 only
}

# Shared map for rate zones when this file is included under http {}
# (nginx requires limit_req_zone at http level — operators often put these two
# lines in nginx.conf and keep only server{} blocks in conf.d.)
#
# limit_req_zone $binary_remote_addr zone=seip_login:10m rate=5r/m;
# limit_req_zone $binary_remote_addr zone=seip_api:10m rate=30r/s;

server {
    listen 80;
    server_name seip.example.school.th;
    # Redirect all HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name seip.example.school.th;

    ssl_certificate     /etc/ssl/seip/fullchain.pem;
    ssl_certificate_key /etc/ssl/seip/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    # --- security headers (SEC-OWASP A05 / SEIP-OPS-004) ---
    # Enable HSTS only when this hostname is permanently HTTPS.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Permitted-Cross-Domain-Policies none always;
    # CSP: start report-only; tighten once UI asset inventory is stable.
    # add_header Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: blob:; connect-src 'self';" always;

    # Uploads go direct to MinIO via presigned URL — not through this proxy body.
    client_max_body_size 0;

    # Hide nginx version
    server_tokens off;

    # Login: tight per-IP limit (SEC-AUTH-5). Requires limit_req_zone seip_login at http{}.
    # Burst allows a short legitimate retry storm without opening a brute-force window.
    location = /api/v1/auth/login {
        limit_req zone=seip_login burst=8 nodelay;
        limit_req_status 429;

        proxy_pass http://seip_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /api/ {
        limit_req zone=seip_api burst=60 nodelay;
        limit_req_status 429;

        proxy_pass http://seip_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://seip_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
