{
  "realm": "seip",
  "displayName": "SEIP (dev)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "browserFlow": "seip browser",
  "attributes": {
    "acr.loa.map": "{\"pwd\":1,\"mfa\":2}"
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ADMIN_EDIT\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "seip-api",
      "description": "Access to the SEIP API: subject, audience, account link and step-up level",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience seip-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "seip-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "seip_uid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "seip_uid",
            "claim.name": "seip_uid",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "acr loa level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "seip-mobile",
      "name": "SEIP mobile (Flutter)",
      "description": "Public client, PKCE via the system browser (ADR-0014 §5).",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "th.go.seip.app:/oauth2redirect"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "seip-api"
      ]
    },
    {
      "clientId": "seip-web",
      "name": "SEIP web BFF",
      "description": "Confidential client for the Fastify BFF (ADR-0014 §4).",
      "publicClient": false,
      "secret": "seip-web-dev-secret-not-for-real-use",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "seip-api"
      ]
    },
    {
      "clientId": "seip-test",
      "name": "Integration tests only (dev realm)",
      "description": "Integration tests only (dev realm): the browser flow driven over HTTP by tests/helpers/keycloak.mjs. Never present in a staging or production realm.",
      "publicClient": false,
      "secret": "seip-test-dev-secret-not-for-real-use",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:5999/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "seip-api"
      ]
    },
    {
      "clientId": "seip-provisioner",
      "name": "SEIP account provisioning (service account)",
      "description": "The API creates Keycloak users for SEIP accounts (ADR-0014): client credentials only, manage-users in this realm, no user-facing flows.",
      "publicClient": false,
      "secret": "seip-provisioner-dev-secret-not-for-real-use",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "defaultClientScopes": []
    }
  ],
  "authenticationFlows": [
    {
      "alias": "seip browser",
      "description": "Browser login with step-up: password is LoA 1 (pwd), OTP is LoA 2 (mfa) — ADR-0014 §6",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "seip browser forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "seip browser forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "seip loa1",
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "seip loa2",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "seip loa1",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "seip loa1 condition",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "seip loa2",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "seip loa2 condition",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "seip loa1 condition",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "28800"
      }
    },
    {
      "alias": "seip loa2 condition",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "300"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-seip-provisioner",
      "enabled": true,
      "serviceAccountClientId": "seip-provisioner",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ]
}
